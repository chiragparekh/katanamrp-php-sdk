{
    "name": "chiragparekh/katana-php-sdk",
    "version": "0.0.1",
    "description": "PHP SDK for KatanaMRP",
    "autoload": {
        "psr-4": {
            "Chirag\\KatanaPhpSdk\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Chirag Parekh",
            "email": "chiragparekhn@gmail.com"
        }
    ],
    "require": {
        "saloonphp/saloon": "^3.0",
        "saloonphp/pagination-plugin": "^2.0"
    },
    "require-dev": {
        "laravel/pint": "^1.24"
    },
    "scripts": {
        "lint": [
            "pint --parallel"
        ],        
        "test:lint": [
            "pint --test --parallel"
        ],
        "test": [
            "@test:lint"
        ]
    }
}
